{
  "manifest_version": 3,
  "name": "MEMOIR",
  "version": "0.2.0",
  "description": "Capture and organize useful knowledge from anywhere.",

  "permissions": [
    "contextMenus",
    "storage"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html"
  }
}